{
  "name": "iplan",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "yarn workspace @iplan/db db:generate",
    "db:migrate": "yarn workspace @iplan/db db:migrate",
    "db:seed": "yarn workspace @iplan/db db:seed",
    "db:setup": "yarn db:up && yarn workspace @iplan/db db:setup",
    "db:studio": "yarn workspace @iplan/db db:studio",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build",
    "legacy:convert": "yarn workspace @iplan/db legacy:convert"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  }
}
