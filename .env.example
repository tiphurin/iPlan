# Copy to .env for local development: cp .env.example .env
# Defaults below match docker-compose.yml. Production values live in Vercel → Settings → Environment Variables.
# Where each production value comes from: docs/INFRA.md

# --- Database (Postgres) ---
# Local: Postgres in Docker. Production: Neon → project "iplan" → Connection string (pooled).
DATABASE_URL=postgres://iplan:iplan@localhost:5432/iplan

# --- Auth (Better Auth) ---
# Random 32+ byte secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-local-only
# Public URL of the app (web and API share one origin). Production: https://<project>.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web). Optional locally: dev login works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shows the one-tap "Dev login" button. Must be false (or unset) in production.
DEV_LOGIN_ENABLED=true

# --- File storage (S3 API) ---
# Local: MinIO in Docker. Production: Backblaze B2 → Buckets → "iplan-attachments" → Endpoint, and Application Keys.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=iplan-attachments
S3_ACCESS_KEY_ID=iplan
S3_SECRET_ACCESS_KEY=iplan-minio-secret
# MinIO needs path-style URLs; Backblaze B2 works with either.
S3_FORCE_PATH_STYLE=true
