# Copy to .env for local development: cp .env.example .env
# Defaults below match docker-compose.yml. Production values live in Vercel → Settings → Environment Variables.
# Where each production value comes from: docs/INFRA.md

# --- Database (Postgres) ---
# Local: Postgres in Docker. Production: Neon → project "iplan" → Connection string (pooled).
DATABASE_URL=postgres://iplan:iplan@localhost:5432/iplan

# --- Auth (Better Auth) ---
# At least 32 characters. Production: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=local-dev-only-secret-not-for-production-use
# Public URL of the app (web and API share one origin). Production: https://<project>.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web). Optional locally: dev login works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails that become active admins on first sign-in (everyone else waits for approval).
# Production: your own Google account, e.g. you@gmail.com
ADMIN_EMAILS=
# First password of the built-in admin account (username: admin). It must be changed at first
# sign-in (Profile → Change password). Setting a new value later resets the password.
# Production: Vercel → Environment Variables; never commit a real one.
SUPERADMIN_PASSWORD=1234

# --- Email (Gmail SMTP, free, no card) ---
# Unset = emails are printed in the server log instead of sent.
# Production: Google account → Security → 2-Step Verification on → App passwords → create one.
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to "iPlan <SMTP_USER>"
MAIL_FROM=

# Shows the one-tap "Dev login" button. Must be false (or unset) in production.
DEV_LOGIN_ENABLED=true

# --- File storage ---
# local: files under LOCAL_STORAGE_DIR (development only). s3: any S3-compatible bucket (production: Backblaze B2).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# Only used when STORAGE_DRIVER=s3. Production: Backblaze B2 → Buckets → "iplan-attachments" → Endpoint, and Application Keys.
S3_ENDPOINT=
S3_REGION=us-west-004
S3_BUCKET=iplan-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
